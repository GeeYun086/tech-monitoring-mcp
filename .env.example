# ⚠️ DATABASE_URL은 아래 localhost 기본값을 그대로 쓰지 마세요.
#
# 이 프로젝트는 **팀이 공유하는 Supabase DB 하나**를 보도록 설계돼 있습니다.
# 아래 localhost 주소는 docker-compose.yml로 Postgres를 직접 띄워 쓰는
# 로컬 실험용이고, 평소 개발에는 쓰지 않습니다.
#
# 2026-08-19에 실제로 겪은 사고: 새 PC에서 이 파일을 그대로 복사했더니
# localhost를 보게 됐고, 그래서 (1) 빈 DB가 하나 더 생겨 마이그레이션을
# 처음부터 다시 적용해야 했고 (2) 기사를 다시 수집하느라 Tavily 크레딧을
# 두 번 썼으며 (3) 라벨이 두 DB로 갈라질 뻔했습니다.
#
# 마이그레이션·수집 결과·라벨은 전부 **DB에 묶여 있지 컴퓨터에 묶여
# 있지 않습니다.** 같은 Supabase 주소를 넣으면 새 PC에서도
#   - 마이그레이션은 전부 "already applied"로 건너뛰고
#   - 이미 수집된 기사를 그대로 쓰므로 크레딧이 0이며
#   - 라벨이 한곳에 쌓입니다.
#
# Supabase 주소는 별도 배포가 필요 없습니다(이미 클라우드에 떠 있음).
# 팀 담당자에게 받아서 아래 줄을 통째로 바꿔 넣으세요. 비밀번호가 들어
# 있으므로 이 값은 절대 커밋하지 마세요(.env는 .gitignore에 있음).
#
#   DATABASE_URL=postgresql://<user>:<password>@<project>.pooler.supabase.com:5432/postgres
#
DATABASE_URL=postgresql://tm_user:tm_pass@localhost:5432/tech_monitoring

# tavily.com — 무료 티어 월 1,000 크레딧, 신용카드 등록 불필요.
# 화이트리스트 사이트 목록은 collectors/search_engine.py에 코드로 관리한다.
# 주간 수집 1회에 약 54크레딧을 쓴다(같은 DB를 공유하면 팀 전체가 1회만 쓴다).
TAVILY_API_KEY=

# 2026-08-24부로 주간 자동 수집(pipeline_v2)은 이 키를 안 쓴다 — "이번 주
# 주요 키워드" 화면·Gemini 동의어 병합 단계를 파이프라인에서 뺐다(비용 대비
# 품질이 낮다는 판단). analysis/keyword_merge.py를 단독 실행하거나
# pipeline_v3 비교 실험을 돌릴 때만 필요. 비어 있어도 그쪽은 "전부 단독
# 그룹"으로 폴백한다.
GEMINI_API_KEY=
