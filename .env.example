DATABASE_URL=postgresql://tm_user:tm_pass@localhost:5432/tech_monitoring

# Naver 검색 API (openapi.naver.com) — 없으면 Naver 수집은 자동 skip [확인 필요]
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# v2(검색엔진+Gemini) — 커스텀 검색엔진(cx)은 programmablesearchengine.google.com에서
# 화이트리스트 사이트로 직접 구성한 것을 쓴다. 없으면 collectors/search_engine.py가 skip.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
GEMINI_API_KEY=
